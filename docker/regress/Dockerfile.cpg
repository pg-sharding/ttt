FROM ubuntu:noble

ARG PG_MAJOR=18

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    ca-certificates \
    libssl-dev \
    libreadline-dev \
    zlib1g-dev \
    flex \
    bison \
    bc \
    && rm -rf /var/lib/apt/lists/*

# Assert-enabled PostgreSQL build from upstream REL_${PG_MAJOR}_STABLE
RUN git clone --depth 1 --branch REL_${PG_MAJOR}_STABLE https://github.com/postgres/postgres.git /pg
RUN cd /pg && CONF="--without-icu"; \
    if [ "$(echo "$PG_MAJOR >= 18" | bc)" = 1 ]; then CONF="$CONF --without-mdblocales"; fi; \
    if [ "$(echo "$PG_MAJOR <= 15" | bc)" = 1 ]; then CONF=""; fi; \
    ./configure --prefix=/usr/local/pgsql --enable-cassert --enable-debug $CONF \
    && make -j"$(nproc)" && make install

COPY . /transaction_transients_trace
WORKDIR /transaction_transients_trace

RUN PATH=/usr/local/pgsql/bin:$PATH make USE_PGXS=1 && PATH=/usr/local/pgsql/bin:$PATH make USE_PGXS=1 install

RUN useradd -ms /bin/bash postgres
RUN chown -R postgres:postgres /transaction_transients_trace

USER postgres

ENTRYPOINT [ "/transaction_transients_trace/docker/regress/run_tests_cpg.sh" ]
